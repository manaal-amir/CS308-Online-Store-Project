generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// options for role column in  the User table
enum Role {
  CUSTOMER
  SALES_MANAGER
  PRODUCT_MANAGER
  SUPPORT_AGENT
}

// options for the status of an order
enum OrderStatus {
  PROCESSING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChatStatus {
  WAITING // in the queue, no agent yet
  ACTIVE // claimed by an agent
  CLOSED
}

enum ChatSenderType {
  GUEST
  CUSTOMER
  AGENT
}

// PEOPLE TABLE
/// all users share this table: customers, managers, agents
model User {
  id           Int      @id @default(autoincrement())
  name         String
  lastname     String
  email        String   @unique
  passwordHash String // HASHED
  taxId        String? // oprional for managers, agents; mandatory for customers
  homeAddress  String? // optional because Managers and Agents don't need it, API should check it for customers
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart     Cart?
  orders   Order[]
  wishList WishList?

  ratings  Rating[]
  comments Comment[]

  refundRequests  RefundRequest[] @relation("RefundRequester")
  resolvedRefunds RefundRequest[] @relation("RefundResolver")

  chatsAsCustomer ChatConversation[] @relation("ChatCustomer")
  chatsAsAgent    ChatConversation[] @relation("ChatAgent")
  chatMessages    ChatMessage[]
}

// CATALOG TABLES
///category table: producst type: vinyl, record player, accesssory
model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  Products Product[]
}

/// genre table: different music styles
model Genre {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  Artists     Artist[]
  Products    Product[]
  description String?
}

/// Product Table
model Product {
  id             Int      @id @default(autoincrement())
  name           String
  model          String //edition
  serialNumber   String   @unique
  quantity       Int      @default(0) //stock
  price          Decimal  @db.Decimal(10, 2) // current selling price (discount already applied)
  originalPrice  Decimal? @db.Decimal(10, 2) // set only while a discount is active
  cost           Decimal? @db.Decimal(10, 2) //optional bc if its empty just use 0.5xprice
  warrantyStatus String
  distributor    String //label or distribution
  description    String //required for req 7
  imageUrl       String? //maybe can add default image
  createdAt      DateTime @default(now())

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  artistId Int?
  artist   Artist? @relation(fields: [artistId], references: [id])

  genreId Int?
  genre   Genre? @relation(fields: [genreId], references: [id])

  discounts Discount[]

  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishListItems WishListItem[]

  ratings  Rating[]
  comments Comment[]
}

/// Artist Table
model Artist {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  Products    Product[]
  description String?
  imageUrl    String?

  genreId Int?
  genre   Genre? @relation(fields: [genreId], references: [id])
}

///discount table
model Discount {
  id        Int       @id @default(autoincrement())
  rate      Decimal   @db.Decimal(5, 2) // percent off, e.g. 15.00 = 15%
  startsAt  DateTime  @default(now())
  endsAt    DateTime? // null = until removed
  createdAt DateTime  @default(now())

  products Product[]
}

//shopping tables: carts and wishlists
/// Cart table: each logged in user has one cart, the cart is a live item, 
//changes done in prices and quantities can change the info in the cart
model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

/// CartItem: doesnt include price, price should be copied from Product.price
model CartItem {
  id       Int @id @default(autoincrement())
  quantity Int @default(1) // can't exceed the quantity in stock Product.quantity

  cartId Int
  cart   Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId]) // no duplicate products, instead an items quatity is increased
}

// WISHLISTS (also used for "sort by popularity": count WishListItem rows per product)
/// WishList: one per user
model WishList {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishListItem[]
}

/// WishListItem: a product saved in a wishlist
model WishListItem {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  wishListId Int
  wishList   WishList @relation(fields: [wishListId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishListId, productId]) // no duplicates
  @@index([productId]) // popularity count
}

// Orders, Delivery and money management
/// Order table: order is history so new changes arent reflected on it
model Order {
  id              Int         @id @default(autoincrement())
  status          OrderStatus @default(PROCESSING)
  totalPrice      Decimal     @db.Decimal(10, 2)
  deliveryAddress String // copied at checkout, not linked to User.homeAddress
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userId Int
  user   User        @relation(fields: [userId], references: [id])
  items  OrderItem[]

  payment Payment?
  invoice Invoice?

  cardLast4  String  @db.VarChar(4)
  paymentRef String?

  @@index([userId])
}

/// OrderItem table
model OrderItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2) // price actually paid, discount included
  unitCost  Decimal @db.Decimal(10, 2) // product cost at checkout (or 50% of price)

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  RefundRequests RefundRequest[]
}

// PAYMENT, INVOICE, REFUNDS
/// Payment: one per order, result of the mock bank call
model Payment {
  id        Int           @id @default(autoincrement())
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  bankRef   String? // confirmation from the mock bank
  createdAt DateTime      @default(now())

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// Invoice: generated after successful payment, PDF is emailed to the customer
model Invoice {
  id            Int       @id @default(autoincrement())
  invoiceNumber String    @unique
  totalAmount   Decimal   @db.Decimal(10, 2)
  issuedAt      DateTime  @default(now())
  pdfPath       String? // where the generated PDF is stored
  emailedAt     DateTime? // null = not sent yet

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([issuedAt]) // sales manager filters invoices by date range
}

// after purchase tables
model Rating {
  id        Int      @id @default(autoincrement())
  value     Int // 1 to 5, range checked in the API
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // one rating per user per product
  @@index([productId])
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String
  isApproved Boolean  @default(false) // product manager flips this
  createdAt  DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isApproved])
}

/// RefundRequest: customer returns one item of a delivered order (within 30 days),
/// sales manager approves or rejects. Refund = OrderItem.unitPrice x quantity (discount kept)
model RefundRequest {
  id           Int          @id @default(autoincrement())
  quantity     Int          @default(1)
  reason       String?
  status       RefundStatus @default(PENDING)
  refundAmount Decimal?     @db.Decimal(10, 2) // filled on approval
  requestedAt  DateTime     @default(now())
  resolvedAt   DateTime?

  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  requesterId Int
  requester   User @relation("RefundRequester", fields: [requesterId], references: [id])

  resolvedById Int? // the sales manager
  resolvedBy   User? @relation("RefundResolver", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([orderItemId])
}

// LIVE CHAT TABLES
/// ChatConversation: guests allowed (customerId null, identified by guestToken)
model ChatConversation {
  id         Int        @id @default(autoincrement())
  status     ChatStatus @default(WAITING)
  guestToken String?    @unique
  createdAt  DateTime   @default(now())
  closedAt   DateTime?

  customerId Int?
  customer   User? @relation("ChatCustomer", fields: [customerId], references: [id])

  agentId Int? // set when an agent claims the chat
  agent   User? @relation("ChatAgent", fields: [agentId], references: [id])

  messages ChatMessage[]

  @@index([status])
}

/// ChatMessage: text and/or one attachment (pdf, image, video)
model ChatMessage {
  id             Int            @id @default(autoincrement())
  senderType     ChatSenderType
  content        String?
  attachmentUrl  String?
  attachmentType String? // MIME type, e.g. image/png
  createdAt      DateTime       @default(now())

  conversationId Int
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId Int? // null for guests
  sender   User? @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}
